# ── Infrastructure Credentials (Database & Cache) ─────────────
POSTGRES_USER=einsof_user
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=einsoflite
REDIS_PASSWORD=your_secure_redis_password_here

# ── Public URLs (Change these to VPS IP when deploying) ─────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001

# ── Admin Authentication ─────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=your_admin_secret_key_here
NEXT_PUBLIC_ADMIN_KEY=your_admin_secret_key_here

TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_ACCESS_TOKEN=your_zerodha_access_token_here

EODHD_API_KEY=your_eodhd_api_key_here
UPSTOX_ACCESS_TOKEN=your_upstox_token_here
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

MARKETSTACK_API_KEY=your_marketstack_api_key_here
NSEBSE_API_KEY=your_nsebse_api_key_here

# ── Bot 3: Scoring Engine Configuration ─────────────
# Schedule: "daily" or "weekly" (weekly runs every Friday at 6 PM)
BOT3_SCHEDULE=daily

# Factor Weights (must add up to 100)
WEIGHT_VALUE=20
WEIGHT_DIVIDEND=20
WEIGHT_QUALITY=20
WEIGHT_MOMENTUM=20
WEIGHT_VOLATILITY=20

SCHEDULER_ENABLED=true
GLOBAL_RATE_LIMIT=7
